# API Keys
GOOGLE_API_KEY=your_gemini_api_key
OPENAI_API_KEY=your_openai_api_key
KLING_ACCESS_KEY=your_kling_access_key
KLING_SECRET_KEY=your_kling_secret_key

# LangSmith Tracing (Optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_api_key
LANGCHAIN_PROJECT=loom-system

# Database
DATABASE_URL=sqlite:///./loom_state.db

# Cost Limits
MAX_COST_USD=10.0

# HITL Timeouts
HITL_TIMEOUT_HOURS=24
HITL_AUTO_APPROVE_LOW_RISK=true

# Concurrency & Rate Limiting
MAX_CONCURRENT_VIDEO_TASKS=5
VIDEO_API_TIMEOUT_SECONDS=300
ENABLE_MOCK_VIDEO=true

# Model Routing
DEFAULT_LLM_PROVIDER=google
DEFAULT_LLM_MODEL=gemini-1.5-pro

# Local Model (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
